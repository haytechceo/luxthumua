# Environment Variables Example
# Copy this file to .env.local and fill in your actual values

# Site Configuration
NEXT_PUBLIC_SITE_URL=https://luxthumua.com

# Google Analytics (optional)
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# Contact Form (if using external service)
# NEXT_PUBLIC_FORM_ENDPOINT=

# Contact form -> TuMu (the shops' internal app). Unset = production endpoint.
# For local testing against TuMu staging, put this line in .env.local:
# NEXT_PUBLIC_TUMU_LEAD_URL=https://jgkcujydhhkfeksxmnlc.supabase.co/functions/v1/web-lead

# Other environment variables as needed
